{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coup-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-02",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "coup_db",
			"database_id": "3f012646-9475-49dd-9156-ebadda2a922a",
			"migrations_dir": "drizzle"
			// "remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM_DO",
				"class_name": "RoomDO"
			}
		]
	},
	"migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ]
